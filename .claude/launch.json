{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "FastAPI backend",
      "runtimeExecutable": "venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "Vite frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000
    },
    {
      "name": "Vite preview (prod build)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "3000"],
      "cwd": "frontend",
      "port": 3000
    }
  ]
}
